{
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"BaaniSnap-LiveTranslatorV.0.05.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!downloads/|assets/|favicon\\.svg|app-icon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
